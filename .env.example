VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-anon-key
VITE_SITE_URL=https://elbilsagenten.se
# Deployments use one canonical snapshot for browser, API and SEO.
# Explicit live mode is for coordinated development configurations only.
VITE_VEHICLE_DATA_MODE=snapshot
VEHICLE_DATA_MODE=snapshot

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SITE_URL=https://elbilsagenten.se

# Public operator details. Real values require the owner's permission to publish.
VITE_OPERATOR_NAME=
VITE_CONTACT_EMAIL=
VITE_OPERATOR_ORG_NUMBER=
# These attestations require an actual review; setting them is not the review.
PUBLIC_PRIVACY_REVIEWED=false
PUBLIC_IMAGE_RIGHTS_REVIEWED=false

# Cloudflare Pages Functions reads these at runtime. The anon key is sufficient;
# never expose or configure the Supabase service-role key in the frontend.
SUPABASE_ANON_KEY=your-public-anon-key

OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-5.4-mini

# Paid website AI requires a private AI_BUDGET_DB D1 binding and a runtime salt.
# Production defaults to disabled. Do not use VITE_ names or the Supabase service key.
AI_ENABLED=false
AI_BUDGET_SALT=replace-with-a-random-server-secret-at-least-32-characters

# News worker only. Never use VITE_ names for server credentials.
NEWS_BACKEND=supabase
NEWS_OPENAI_MODEL=gpt-6-sol
# Conservative launch source profile. Budget limits and activation live in private Postgres config.
NEWS_SOURCE_PROFILE=official
# Set to 1 on the hosting build to pull published news before sitemap/prerender.
NEWS_BUILD_SYNC=0
